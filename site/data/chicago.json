  "sights": [
    {
      "name": "Art Institute of Chicago",
      "lat": 41.8796,
      "lng": -87.6237,
      "note": "One of America's great art museums, from Seurat's Grande Jatte and Hopper's Nighthawks to the Thorne miniature rooms and a huge Impressionist wing.",
      "hours": "11:00 AM–5:00 PM, till 8:00 PM Thu, closed Tue",
      "ticketUrl": "https://www.artic.edu/visit"
    },
    {
      "name": "Millennium Park",
      "lat": 41.8826,
      "lng": -87.6233,
      "note": "Downtown's showpiece park, home to Anish Kapoor's mirrored Cloud Gate ('The Bean'), the Crown Fountain faces and Frank Gehry's Pritzker Pavilion. Free.",
      "hours": "6:00 AM–11:00 PM daily"
    },
    {
      "name": "Griffin Museum of Science and Industry",
      "lat": 41.7906,
      "lng": -87.5831,
      "note": "A vast hands-on science museum in a 1893 World's Fair palace, with a captured WWII U-boat, a coal mine ride and a full-size 727.",
      "hours": "9:30 AM–4:00 PM daily (to 5:30 PM on many Nov–Dec days)",
      "ticketUrl": "https://www.griffinmsi.org"
    },
    {
      "name": "Skydeck Chicago - Willis Tower",
      "lat": 41.8786,
      "lng": -87.6358,
      "note": "The 103rd-floor observatory of Willis Tower, where glass boxes called The Ledge let you stand over a 412 m drop.",
      "hours": "9:00 AM–8:00 PM, till 9:00 PM Sat (Oct–Feb); longer in summer",
      "ticketUrl": "https://theskydeck.com",
      "bookAhead": true
    },
    {
      "name": "Chicago Architecture Center",
      "lat": 41.8878,
      "lng": -87.6237,
      "note": "A riverside gallery explaining how Chicago invented the skyscraper, with a giant city model; it also runs the city's best-known architecture river cruise.",
      "hours": "10:00 AM–5:00 PM, till 7:00 PM Fri & Sat",
      "ticketUrl": "https://www.architecture.org"
    },
    {
      "name": "Field Museum",
      "lat": 41.8663,
      "lng": -87.617,
      "note": "A natural history museum on the lakefront famous for Sue, the most complete T. rex ever found, plus Egyptian tombs and the man-eating lions of Tsavo.",
      "hours": "9:00 AM–5:00 PM daily (last entry 4:00 PM)",
      "ticketUrl": "https://www.fieldmuseum.org"
    },
    {
      "name": "Wrigley Field",
      "lat": 41.9484,
      "lng": -87.6553,
      "note": "The Cubs' ivy-walled ballpark from 1914, the second-oldest in the major leagues, in the bar-lined Wrigleyville neighbourhood.",
      "hours": "Cubs home games Apr–Sep (Oct in playoff years); ballpark tours most days",
      "ticketUrl": "https://www.mlb.com/cubs"
    },
    {
      "name": "360 Chicago Observation Deck",
      "lat": 41.8988,
      "lng": -87.6229,
      "note": "The 94th-floor observatory atop 875 North Michigan Avenue (the former Hancock Center), with lake views and the tilting TILT window ride.",
      "hours": "9:00 AM–11:00 PM daily (last entry ~10:00 PM)",
      "ticketUrl": "https://360chicago.com"
    },
    {
      "name": "Shedd Aquarium",
      "lat": 41.8676,
      "lng": -87.614,
      "note": "A grand 1930 lakefront aquarium with a Caribbean reef tank, beluga whales and sea otters in its Abbott Oceanarium.",
      "hours": "9:00 AM–5:00 PM daily (fall/winter 2026)",
      "ticketUrl": "https://www.sheddaquarium.org",
      "bookAhead": true
    },
    {
      "name": "Lincoln Park Zoo",
      "lat": 41.9211,
      "lng": -87.634,
      "note": "One of the last free zoos in the US, with lions, gorillas and polar bears set among lagoons a short walk from the lake.",
      "hours": "10:00 AM–5:00 PM daily (to 4:00 PM Nov–Mar). Free"
    },
    {
      "name": "Chicago Riverwalk",
      "lat": 41.8875,
      "lng": -87.6265,
      "note": "A promenade along the main branch of the Chicago River, lined with cafés, wine bars and boat-tour docks beneath the skyscrapers.",
      "hours": "6:00 AM–11:00 PM daily"
    },
    {
      "name": "Navy Pier",
      "lat": 41.8917,
      "lng": -87.6086,
      "note": "A 1916 pier stretching 1 km into Lake Michigan, with the Centennial Wheel, boat cruises, Chicago Shakespeare Theater and skyline views. Free to enter.",
      "hours": "11:00 AM–8:00 PM Sun–Thu, till 10:00 PM Fri & Sat (Sep–Dec)"
    },
    {
      "name": "Garfield Park Conservatory",
      "lat": 41.8863,
      "lng": -87.7173,
      "note": "One of the largest glasshouse conservatories in the US, with a fern room that recreates a prehistoric swamp; a short walk from the Green Line.",
      "hours": "10:00 AM–5:00 PM Thu–Sun, 10:00 AM–8:00 PM Wed, closed Mon & Tue",
      "ticketUrl": "https://garfieldconservatory.org"
    },
    {
      "name": "Richard H. Driehaus Museum",
      "lat": 41.8942,
      "lng": -87.6268,
      "note": "A lavish Gilded Age mansion with Tiffany glass and original 1880s interiors, tucked between River North and the Mag Mile.",
      "hours": "11:00 AM–5:00 PM Thu–Sun, till 7:00 PM Wed, closed Mon & Tue",
      "ticketUrl": "https://driehausmuseum.org"
    },
    {
      "name": "Chicago Cultural Center",
      "lat": 41.8838,
      "lng": -87.625,
      "note": "The city's former central library, now a free arts venue crowned by the world's largest Tiffany glass dome.",
      "hours": "10:00 AM–5:00 PM daily, closed holidays. Free"
    },
    {
      "name": "Clarence F. Buckingham Fountain",
      "lat": 41.8758,
      "lng": -87.6189,
      "note": "Grant Park's 1927 rococo fountain, with 20-minute water shows on the hour and music and lights after dark.",
      "hours": "Water shows hourly ~8:00 AM–11:00 PM, May to late Oct; switched off for winter"
    },
    {
      "name": "Oak Street Beach",
