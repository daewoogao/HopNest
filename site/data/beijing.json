  "sights": [
    {
      "name": "Mutianyu Great Wall",
      "lat": 40.438,
      "lng": 116.5619,
      "note": "A restored, forested stretch of the Great Wall with 23 watchtowers, a cable car up and a toboggan down; about 70 km north of the city, reached by tour bus, private car or the seasonal bus from Dongzhimen.",
      "hours": "~7:30 AM–5:30 PM Apr–Oct, ~8:00 AM–5:00 PM Nov–Mar",
      "rating": 4.8,
      "bookAhead": true
    },
    {
      "name": "Summer Palace",
      "lat": 39.9975,
      "lng": 116.2689,
      "note": "The Qing emperors' lakeside retreat: Longevity Hill, the painted Long Corridor and boat rides on Kunming Lake.",
      "hours": "6:30 AM–6:00 PM Apr–Oct, 7:00 AM–5:00 PM Nov–Mar (inner halls close earlier)",
      "rating": 4.5,
      "ticketUrl": "https://www.summerpalace-china.com",
      "bookAhead": true
    },
    {
      "name": "The Palace Museum (Forbidden City)",
      "lat": 39.9158,
      "lng": 116.3908,
      "note": "The vast walled palace of the Ming and Qing emperors, with 980 buildings; enter from Tiananmen in the south and exit north by Jingshan Park.",
      "hours": "8:30 AM–5:00 PM Apr–Oct, 8:30 AM–4:30 PM Nov–Mar; closed Mon (except holidays)",
      "rating": 4.4,
      "ticketUrl": "https://en.dpm.org.cn",
      "bookAhead": true
    },
    {
      "name": "Temple of Heaven",
      "lat": 39.8822,
      "lng": 116.4066,
      "note": "Ming-era altar complex where emperors prayed for good harvests, centred on the triple-roofed Hall of Prayer; locals dance, sing and play cards in the surrounding park each morning.",
      "hours": "Park 6:00 AM–9:00 PM; halls 8:00 AM–5:30 PM (to 5:00 PM Nov–Mar)",
      "rating": 4.5,
      "bookAhead": true
    },
    {
      "name": "The Great Wall at Badaling",
      "lat": 40.3542,
      "lng": 116.0069,
      "note": "The most visited and most heavily restored Great Wall section, easiest to reach by public transport: high-speed train from Beijing North or Qinghe to Badaling Great Wall station, or suburban line S2.",
      "hours": "~6:30 AM–4:30 PM last entry Apr–Oct, ~7:30 AM–4:00 PM Nov–Mar",
      "rating": 4.5,
      "bookAhead": true
    },
    {
      "name": "Jingshan Park",
      "lat": 39.9236,
      "lng": 116.3906,
      "note": "A man-made hill opposite the Forbidden City's north gate whose summit pavilion gives the classic view over the palace's golden roofs.",
      "hours": "6:00 AM–9:00 PM Apr–Oct, 6:30 AM–8:00 PM Nov–Mar",
      "rating": 4.5
    },
    {
      "name": "Lama Temple (Yonghegong)",
      "lat": 39.9469,
      "lng": 116.4111,
      "note": "Beijing's largest Tibetan Buddhist temple, a former prince's palace thick with incense, ending at an 18 m Maitreya Buddha carved from a single sandalwood trunk.",
      "hours": "9:00 AM–4:30 PM Apr–Oct, 9:00 AM–4:00 PM Nov–Mar",
      "rating": 4.5,
      "bookAhead": true
    },
