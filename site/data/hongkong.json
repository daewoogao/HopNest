  "sights": [
    {
      "name": "Victoria Peak (The Peak)",
      "lat": 22.2712,
      "lng": 114.1498,
      "note": "Hong Kong Island's highest summit, where the Peak Tower and Sky Terrace 428 look straight down over the skyscrapers and harbour; best near sunset.",
      "hours": "Peak area open 24 h; Sky Terrace 428 10:00 AM–10:00 PM daily",
      "ticketUrl": "https://www.thepeak.com.hk/en"
    },
    {
      "name": "Hong Kong Disneyland",
      "lat": 22.313,
      "lng": 114.0413,
      "note": "Disney theme park on Lantau with the castle, Frozen-themed World of Frozen and nightly fireworks; reached directly by the MTR Disneyland Resort Line.",
      "hours": "Typically 10:30 AM–8:30 PM; varies by day, check the park calendar",
      "ticketUrl": "https://www.hongkongdisneyland.com/",
      "bookAhead": true
    },
    {
      "name": "Tian Tan Buddha (Big Buddha)",
      "lat": 22.254,
      "lng": 113.905,
      "note": "A 34 m bronze seated Buddha atop 268 steps on Ngong Ping plateau, beside Po Lin Monastery; reach it by cable car or bus from Tung Chung MTR.",
      "hours": "10:00 AM–5:30 PM daily"
    },
    {
      "name": "Star Ferry",
      "lat": 22.2937,
      "lng": 114.1685,
      "note": "Green-and-white ferries running since 1888 across Victoria Harbour between Tsim Sha Tsui and Central for a few dollars; a classic skyline crossing.",
      "hours": "About 6:30 AM–11:30 PM daily, every 6–12 min",
      "ticketUrl": "https://www.starferry.com.hk/en/home"
    },
    {
      "name": "Ocean Park",
      "lat": 22.2467,
      "lng": 114.1758,
      "note": "Marine-themed park on the south side with giant pandas, aquariums, a cliffside cable car and thrill rides; Ocean Park station on the MTR South Island Line is at the gate.",
      "hours": "Typically 10:00 AM–6:00 PM or 7:00 PM; varies by day, check the calendar",
      "ticketUrl": "https://www.oceanpark.com.hk/en",
      "bookAhead": true
    },
    {
      "name": "Nan Lian Garden",
      "lat": 22.3399,
      "lng": 114.2047,
      "note": "Free Tang-dynasty-style landscaped garden with a golden pavilion, ponds and sculpted pines, right beside Chi Lin Nunnery near Diamond Hill MTR.",
      "hours": "6:30 AM–7:00 PM daily"
    },
    {
      "name": "Ngong Ping 360",
      "lat": 22.289,
      "lng": 113.942,
      "note": "A 5.7 km cable car from Tung Chung over the bay and Lantau's hills up to Ngong Ping and the Big Buddha; the crystal-floor cabins are popular.",
      "hours": "Mon–Fri 10:00 AM–6:00 PM; Sat, Sun & holidays 9:00 AM–6:30 PM",
      "ticketUrl": "https://www.np360.com.hk/en/",
      "bookAhead": true
    },
    {
      "name": "Dragon's Back",
      "lat": 22.246,
      "lng": 114.239,
      "note": "An easy ridge hike above Shek O with sea views on both sides, ending at Big Wave Bay beach; start from the To Tei Wan bus stop on Shek O Road.",
      "hours": "Open 24 h; go in daylight"
    },
    {
      "name": "Hong Kong Tramways (Ding Ding)",
      "lat": 22.2826,
      "lng": 114.1576,
      "note": "Double-decker trams rattling along Hong Kong Island's north shore from Kennedy Town to Shau Kei Wan; sit upstairs at the front for street views.",
      "hours": "About 5:30 AM–midnight daily",
      "ticketUrl": "https://www.hktramways.com/en/"
    },
    {
      "name": "Peak Tram",
      "lat": 22.2777,
      "lng": 114.1597,
      "note": "Funicular climbing steeply from Garden Road in Central to the Peak since 1888; queues can be long in the afternoon, so go early.",
      "hours": "7:30 AM–11:00 PM daily",
      "ticketUrl": "https://www.thepeak.com.hk/en",
      "bookAhead": true
    },
    {
      "name": "Chi Lin Nunnery",
      "lat": 22.3408,
      "lng": 114.2051,
      "note": "Tranquil Buddhist complex built entirely of timber without nails, with lotus ponds and bonsai courtyards; free to enter.",
      "hours": "9:00 AM–5:00 PM daily"
    },
    {
      "name": "Hong Kong Museum of History",
      "lat": 22.3014,
      "lng": 114.1772,
      "note": "Its permanent 'Hong Kong Story' exhibition, reopened in April 2026 after a five-year renovation, walks from prehistoric times to the present; free entry.",
      "hours": "10:00 AM–6:00 PM (to 7:00 PM Sat, Sun & holidays), closed Tue",
      "ticketUrl": "https://hk.history.museum/en/"
    },
    {
      "name": "Temple Street Night Market",
      "lat": 22.306,
      "lng": 114.1698,
      "note": "Evening street market in Jordan/Yau Ma Tei with stalls of trinkets, fortune tellers and open-air dai pai dong seafood and clay-pot rice.",
      "hours": "About 6:00 PM–midnight daily"
    },
    {
      "name": "Tsim Sha Tsui Promenade",
      "lat": 22.2934,
      "lng": 114.1739,
      "note": "Free waterfront walk with the Avenue of Stars and the best head-on view of the Hong Kong Island skyline; the Symphony of Lights show runs at 8 PM.",
      "hours": "Open 24 h; Symphony of Lights 8:00 PM nightly"
    },
    {
      "name": "Lan Kwai Fong",
      "lat": 22.281,
      "lng": 114.1555,
      "note": "Steep L-shaped lanes in Central packed with bars and clubs, where the crowd spills onto the street on weekend nights.",
      "hours": "Bars from late afternoon until 2:00 AM or later"
    },
    {
      "name": "Happy Valley Racecourse",
      "lat": 22.2725,
      "lng": 114.183,
      "note": "Floodlit horse racing ringed by skyscrapers; Wednesday race nights from September to July draw a lively crowd for a small entry fee.",
      "hours": "Wednesday race nights about 6:45–11:00 PM (Sept–July); museum and grounds otherwise"
    },
    {
      "name": "Sik Sik Yuen Wong Tai Sin Temple",
      "lat": 22.3425,
      "lng": 114.1937,
      "note": "Busy Taoist temple where worshippers shake fortune sticks under incense smoke, next to Wong Tai Sin MTR station.",
      "hours": "7:30 AM–4:30 PM daily"
    }
