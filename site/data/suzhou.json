  "sights": [
    {
      "name": "Humble Administrator's Garden",
      "lat": 31.3255,
      "lng": 120.626,
      "note": "The largest and most celebrated of Suzhou's UNESCO-listed classical gardens: Ming-era pavilions, lotus ponds and winding corridors spread across about 5 hectares; arrive at opening to beat the tour groups.",
      "hours": "~7:30 AM–5:30 PM (Mar–Oct); closes ~1 h earlier in winter",
      "bookAhead": true
    },
    {
      "name": "Suzhou Museum",
      "lat": 31.3245,
      "lng": 120.6235,
      "note": "I. M. Pei's white-walled, grey-roofed museum next to the Humble Administrator's Garden, as much a modern take on a Suzhou garden as a home for Wu-region ceramics, jade and paintings; entry is free but must be reserved with your passport.",
      "hours": "9:00 AM–5:00 PM, closed Mondays",
      "ticketUrl": "https://www.szmuseum.com/",
      "bookAhead": true
    },
    {
      "name": "Lion Grove Garden",
      "lat": 31.3228,
      "lng": 120.625,
      "note": "A Yuan-dynasty garden famous for its labyrinth of contorted Taihu rocks, said to look like lions, which you clamber through on twisting paths.",
      "hours": "~7:30 AM–5:30 PM (Mar–Oct); closes earlier in winter"
    },
    {
      "name": "Pingjiang Road",
      "lat": 31.317,
