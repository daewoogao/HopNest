  "sights": [
    {
      "name": "Universal Studios Japan",
      "lat": 34.6654,
      "lng": 135.4323,
      "note": "Osaka's big theme park, home to Super Nintendo World and the Wizarding World of Harry Potter. Not on the metro: take the JR Yumesaki Line to Universal City.",
      "hours": "Hours vary by day, typically 9:00 AM–7:00/9:00 PM; check the park calendar",
      "ticketUrl": "https://www.usj.co.jp/web/en/us",
      "bookAhead": true
    },
    {
      "name": "Dotonbori",
      "lat": 34.6687,
      "lng": 135.5013,
      "note": "A canal-side street of giant neon signs and street-food stalls, best after dark from Ebisu Bridge by the Glico runner sign.",
      "hours": "Open 24 hours; most food stalls ~11:00 AM–11:00 PM"
    },
    {
      "name": "Osaka Aquarium Kaiyukan",
      "lat": 34.6545,
      "lng": 135.4289,
      "note": "One of the world's largest aquariums, with whale sharks circling a central tank nine floors deep.",
      "hours": "10:00 AM–8:00 PM daily (last entry 7:00 PM; hours vary by season)",
      "ticketUrl": "https://www.kaiyukan.com/language/eng/",
      "bookAhead": true
    },
    {
      "name": "Osaka Castle",
      "lat": 34.6873,
      "lng": 135.5259,
      "note": "A rebuilt 16th-century castle keep housing a museum of Toyotomi Hideyoshi's era, with a rooftop lookout over the moats and park.",
      "hours": "9:00 AM–5:00 PM daily (last entry 4:30 PM)",
      "ticketUrl": "https://www.osakacastle.net/english/"
    },
    {
      "name": "Kuromon Market",
      "lat": 34.6655,
      "lng": 135.5066,
      "note": "A covered market lane of seafood, wagyu skewers and fruit stalls where you can eat as you walk.",
      "hours": "~9:00 AM–6:00 PM; many stalls close early, some shut on Sundays"
    },
    {
      "name": "Umeda Sky Building",
      "lat": 34.7053,
      "lng": 135.4907,
      "note": "Twin towers joined at the top by the open-air Floating Garden Observatory, a favorite spot for sunset over the city.",
      "hours": "Observatory 9:30 AM–10:30 PM daily (last entry 10:00 PM)",
      "ticketUrl": "https://www.skybldg.co.jp/en/"
    },
    {
      "name": "Sumiyoshi Taisha",
      "lat": 34.6126,
      "lng": 135.493,
      "note": "One of Japan's oldest Shinto shrines, known for its arched Sorihashi bridge and distinctive straight-roofed halls.",
      "hours": "6:00 AM–5:00 PM (opens 6:30 AM Oct–Mar); grounds free"
    },
    {
      "name": "Osaka Museum of Housing and Living",
      "lat": 34.711,
      "lng": 135.5113,
      "note": "A full-size indoor reconstruction of an 1830s Osaka street that you can walk through, with kimono rental for photos.",
      "hours": "10:00 AM–5:00 PM, closed Tue"
    },
    {
      "name": "Shinsekai & Tsutenkaku",
      "lat": 34.6525,
      "lng": 135.5063,
      "note": "A retro, slightly gritty district of kushikatsu joints and arcades beneath the Tsutenkaku tower.",
      "hours": "Streets 24 hours; Tsutenkaku tower 10:00 AM–8:00 PM"
    },
    {
      "name": "Tempozan Ferris Wheel",
      "lat": 34.6563,
      "lng": 135.4313,
      "note": "A 112 m Ferris wheel beside Kaiyukan with bay and bridge views; some gondolas have glass floors.",
      "hours": "10:00 AM–9:00 PM daily"
    },
    {
      "name": "Shitennoji",
      "lat": 34.6537,
      "lng": 135.5164,
      "note": "Founded in 593, it is among Japan's oldest Buddhist temples, with a five-story pagoda and a free outer precinct.",
      "hours": "8:30 AM–4:30 PM (to 4:00 PM Oct–Mar)"
    },
    {
      "name": "Harukas 300 Observation Deck",
      "lat": 34.6459,
      "lng": 135.5137,
      "note": "The glass-walled top floors of Abeno Harukas, one of Japan's tallest buildings, with 360° views over the Osaka plain.",
      "hours": "9:00 AM–10:00 PM daily (last entry 9:30 PM)",
      "ticketUrl": "https://www.abenoharukas-300.jp/en/"
    },
    {
      "name": "Namba Yasaka Shrine",
      "lat": 34.6614,
      "lng": 135.4972,
      "note": "A small shrine whose stage is a huge lion's head with gaping jaws, said to swallow bad luck.",
      "hours": "6:00 AM–5:00 PM daily; free"
    },
    {
      "name": "Hozenji Yokocho",
      "lat": 34.6681,
      "lng": 135.503,
      "note": "A lantern-lit stone alley of tiny restaurants around a moss-covered Fudo statue that visitors splash with water.",
      "hours": "Alley open 24 hours; eateries mostly evenings"
    },
    {
      "name": "Osaka Museum of History",
      "lat": 34.6823,
      "lng": 135.5209,
      "note": "A tower museum tracing Osaka from its 7th-century palace onward, with windows looking straight down on the Naniwa Palace ruins and the castle.",
      "hours": "9:30 AM–5:00 PM, closed Tue",
      "ticketUrl": "https://www.osakamushis.jp/english/"
    },
    {
      "name": "Kids Plaza Osaka",
      "lat": 34.7069,
      "lng": 135.5113,
      "note": "A hands-on children's museum with a multi-story play town, science exhibits and craft corners.",
      "hours": "9:30 AM–5:00 PM, closed Mon"
    },
    {
      "name": "Nakanoshima Park",
      "lat": 34.6925,
      "lng": 135.5083,
      "note": "A free riverside park on an island between two rivers, with a rose garden in front of the old red-brick Central Public Hall.",
      "hours": "Open 24 hours; free"
    }
  ],
