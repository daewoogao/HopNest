    {
      "name": "Tsingtao Beer Museum",
      "lat": 36.0789,
      "lng": 120.3414,
      "note": "Tsingtao's original 1903 German-built brewery on Dengzhou Road, now a museum of brewing history and a working bottling line; the ticket includes draught tastings straight from the source.",
      "hours": "~8:30 AM–5:30 PM daily (to ~6:00 PM in summer); last entry ~1 h before closing",
      "rating": 4.3,
      "bookAhead": true
    },
    {
      "name": "Laoshan Scenic Area",
      "lat": 36.131,
      "lng": 120.582,
      "note": "Granite peaks dropping into the sea, dotted with Taoist temples such as Taiqing Palace; take Metro Line 4 to Dahedong at the scenic-area gate, then the park's own buses between routes, and budget a full day.",
      "hours": "~7:30 AM–5:30 PM (winter hours shorter); last entry mid-afternoon",
      "rating": 4.3,
      "bookAhead": true
    },
    {
      "name": "Badaguan Scenic Area",
      "lat": 36.054,
      "lng": 120.348,
      "note": "Leafy lanes of 1930s villas in European styles, each street lined with a different tree, running down to Huiquan Bay; free to wander and best on foot.",
      "hours": "Open all day; free",
      "rating": 4.4
    },
    {
      "name": "May Fourth Square",
      "lat": 36.0615,
      "lng": 120.379,
