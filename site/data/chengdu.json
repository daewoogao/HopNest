  "sights": [
    {
      "name": "Chengdu Research Base of Giant Panda Breeding",
      "lat": 30.7332,
      "lng": 104.1463,
      "note": "Wooded hillside enclosures in the north of the city where dozens of giant and red pandas live; arrive at opening, as the pandas are most active at morning feeding and nap through the afternoon heat.",
      "hours": "7:30 AM–6:00 PM (winter 8:00 AM–5:30 PM); real-name tickets, booking ahead advised",
      "ticketUrl": "https://www.panda.org.cn/",
      "bookAhead": true
    },
    {
      "name": "Wenshu Monastery",
      "lat": 30.6745,
      "lng": 104.0725,
      "note": "Chengdu's best-preserved Buddhist temple, a working monastery of courtyards, halls and a peaceful teahouse, with a lively vegetarian restaurant.",
      "hours": "8:00 AM–5:00 PM daily; free"
    },
    {
      "name": "Kuanzhai Alley",
      "lat": 30.6695,
      "lng": 104.054,
      "note": "Three restored Qing-era lanes of grey-brick courtyard houses turned into teahouses, snack stalls and bars; busy by day, atmospheric when lit at night.",
      "hours": "Lanes open 24 hours; shops ~9:00 AM–10:00 PM"
    },
    {
      "name": "People's Park (Renmin Park)",
      "lat": 30.658,
      "lng": 104.056,
      "note": "A central park where locals sip tea at the open-air Heming Teahouse, dance, sing and run a famous weekend marriage market; try an ear-cleaning while you wait for your tea.",
      "hours": "~6:00 AM–10:00 PM daily; free"
    },
    {
      "name": "Wuhou Shrine",
      "lat": 30.6458,
      "lng": 104.0466,
      "note": "A temple complex honouring the Three Kingdoms strategist Zhuge Liang and his emperor Liu Bei, with statues of heroes from the period in red-walled halls.",
      "hours": "~8:00 AM–6:00 PM daily"
    },
    {
      "name": "Jinli Pedestrian Street",
      "lat": 30.6449,
      "lng": 104.049,
      "note": "A recreated old-town street next to Wuhou Shrine packed with Sichuan snacks, crafts and lanterns; crowded but fun after dark.",
      "hours": "Open 24 hours; shops ~9:00 AM–10:30 PM"
    },
    {
      "name": "Du Fu Thatched Cottage",
      "lat": 30.6603,
      "lng": 104.0284,
      "note": "A landscaped park of bamboo, ponds and pavilions built where the Tang poet Du Fu lived in exile, with a reconstruction of his cottage.",
      "hours": "8:00 AM–6:00 PM (winter to 5:30 PM)"
    },
    {
      "name": "Sichuan Museum",
      "lat": 30.6661,
      "lng": 104.031,
      "note": "The province's main museum near Du Fu's Cottage, strong on Han-dynasty tomb figures, bronzes, Buddhist sculpture and Tibetan art.",
      "hours": "9:00 AM–5:00 PM, closed Mon; free with a real-name reservation",
      "bookAhead": true
    },
    {
      "name": "Qingyang Palace",
      "lat": 30.6633,
      "lng": 104.0388,
      "note": "One of China's oldest Taoist temples, with the Eight Trigrams Pavilion and a pair of bronze goats said to cure ailments if you rub them.",
      "hours": "~8:00 AM–6:00 PM daily"
    },
    {
      "name": "Chengdu Museum",
      "lat": 30.658,
      "lng": 104.0614,
      "note": "A large modern museum on the west side of Tianfu Square covering the city's history, with a standout gallery of Chinese shadow puppets.",
      "hours": "9:00 AM–5:00 PM, closed Mon; free with a real-name reservation",
      "bookAhead": true
    },
    {
      "name": "Jinsha Site Museum",
      "lat": 30.682,
      "lng": 104.0118,
      "note": "The excavated 3,000-year-old Shu kingdom site, displayed in a vast hall over the dig, plus a gallery whose gold Sun Bird disc became Chengdu's emblem.",
      "hours": "~8:00 AM–6:00 PM daily"
    },
    {
      "name": "Anshun Bridge",
      "lat": 30.6468,
      "lng": 104.0855,
      "note": "A covered bridge-pavilion over the Jin River in the Dongmen area, most photogenic at night when it and the riverbanks are lit up.",
      "hours": "Open 24 hours; lights on after dusk"
    },
    {
      "name": "Daci Temple",
      "lat": 30.6556,
      "lng": 104.0848,
      "note": "A small, calm Buddhist temple founded in the Tang dynasty, now an oasis in the middle of the Taikoo Li shopping district off Chunxi Road.",
      "hours": "~8:00 AM–5:00 PM daily"
    },
    {
      "name": "Wangjianglou Park",
      "lat": 30.631,
      "lng": 104.0906,
      "note": "A riverside park beside Sichuan University with more than 150 varieties of bamboo and a Qing-dynasty tower honouring the Tang poet Xue Tao.",
      "hours": "~6:00 AM–9:00 PM daily"
    },
    {
      "name": "Chengdu Eastern Memory",
      "lat": 30.6718,
      "lng": 104.1225,
      "note": "A former electronics factory complex turned into a creative park of brick buildings, murals, galleries and cafés, popular for photos.",
      "hours": "Grounds open 24 hours; venues ~10:00 AM–10:00 PM"
    },
    {
      "name": "Mount Qingcheng",
      "lat": 30.9007,
      "lng": 103.571,
      "note": "A forested Taoist mountain about 65 km northwest of the city with temples along stone stairways; a day trip by high-speed train from Chengdu Railway Station to Qingchengshan (~1 h), combinable with the Dujiangyan irrigation works.",
      "hours": "~8:00 AM–6:00 PM daily"
    }
  ],
  "railStations": [
    {
      "name": "Chengdu East Railway Station",
      "lat": 30.6305,
      "lng": 104.139,
      "note": "The main high-speed hub: bullet trains to Chongqing (~1 h), Xi'an (~3–4 h), Leshan and Emeishan, Guangzhou and Shanghai; on Metro Lines 2 and 7.",
      "hours": "Trains ~6:30 AM–~11:00 PM to individual timetables."
    },
    {
      "name": "Chengdu Railway Station",
      "lat": 30.6975,
      "lng": 104.072,
      "note": "The old north station (Chengdu North) for conventional and some high-speed trains, including the line to Dujiangyan and Qingchengshan; on Metro Lines 1 and 7.",
      "hours": "Trains ~6:00 AM–~midnight to individual timetables."
    },
    {
      "name": "Chengdu South Railway Station",
      "lat": 30.6076,
      "lng": 104.0655,
      "note": "High-speed trains to Leshan, Emeishan and Yibin; the city terminus of the Line 18 airport express to Tianfu Airport, and on Metro Line 1.",
      "hours": "Trains ~6:30 AM–~10:30 PM to individual timetables."
    }
  ],
  "airports": [
    {
      "name": "Chengdu Tianfu International Airport",
      "code": "TFU",
      "lat": 30.3154,
      "lng": 104.4426,
      "transitNote": "The main international airport, ~50 km southeast. Metro Line 18 (shown on this map) express trains reach Chengdu South Railway Station in ~35 min (~¥10); local trains take ~50 min. Line 19 express links to Shuangliu in ~30 min. Taxi ~1 h, ~¥150–200.",
      "hours": "Line 18: first train ~6:00 AM, last ~11:00–11:30 PM. Late arrivals: overnight airport coaches or a taxi."
    },
    {
      "name": "Chengdu Shuangliu International Airport",
      "code": "CTU",
      "lat": 30.577,
      "lng": 103.956,
      "transitNote": "The older airport, ~16 km southwest, now mostly domestic. Metro Line 10 (shown on this map) runs from Terminals 1 and 2 to Taipingyuan, changing for Lines 3 and 7, ~40–50 min to the centre; Line 19 express runs to Tianfu Airport. Taxi ~30–40 min, ~¥50–70.",
      "hours": "Line 10: first train ~6:30 AM, last ~11:00 PM."
    }
  ]
}
