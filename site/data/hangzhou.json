  "sights": [
    {
      "name": "West Lake (Xi Hu)",
      "lat": 30.2469,
      "lng": 120.1442,
      "note": "Hangzhou's UNESCO-listed lake ringed by willow-lined causeways, temples and pagoda-topped hills; walk the Bai Causeway from Broken Bridge to Gushan, stroll the Su Causeway, or take a boat out to the Three Pools Mirroring the Moon.",
      "hours": "Lakeside open 24 h, free; boats ~8:00 AM–5:00 PM",
      "rating": 4.5
    },
    {
      "name": "Lingyin Temple & Feilai Feng",
      "lat": 30.2424,
      "lng": 120.0976,
      "note": "One of China's largest and most active Buddhist temples, reached through the Feilai Feng grottoes, a limestone hillside carved with hundreds of Buddhist figures; separate tickets for the scenic area and the temple.",
      "hours": "~7:00 AM–6:15 PM daily; last entry ~5:30 PM",
      "rating": 4.5
    },
    {
      "name": "Xixi National Wetland Park",
      "lat": 30.2706,
      "lng": 120.0625,
      "note": "A large protected wetland of fish ponds, reed-lined channels and old villages on the western edge of the city, best explored by electric boat; quieter than West Lake and good for a half day.",
      "hours": "~8:30 AM–5:30 PM (to ~6:00 PM in summer)",
      "rating": 4.2
    },
    {
      "name": "Hefang Street & Qinghefang",
      "lat": 30.2425,
      "lng": 120.1696,
      "note": "A restored late-imperial shopping street below Wushan hill with tea houses, snack stalls and old pharmacies, including the Hu Qing Yu Tang herbal medicine museum; busiest and most atmospheric in the evening.",
      "hours": "Street open all day; shops ~9:00 AM–10:00 PM",
      "rating": 4
    },
    {
      "name": "Longjing Village Tea Fields",
      "lat": 30.2222,
      "lng": 120.098,
      "note": "The hillside village that gives Dragon Well (Longjing) green tea its name, with terraced plantations, family tea houses and walking paths; spring picking season in late March and April is the best time to visit.",
      "hours": "Village open all day; tea houses ~9:00 AM–6:00 PM",
      "rating": 4.2
    },
    {
      "name": "China National Tea Museum",
      "lat": 30.2347,
      "lng": 120.1156,
      "note": "A free museum set among tea gardens on Longjing Road covering the history, varieties and ceremony of Chinese tea, with tasting rooms on site.",
      "hours": "~9:00 AM–4:30 PM, closed Mon",
      "rating": 4.3
    },
    {
      "name": "Former Residence of Hu Xueyan",
      "lat": 30.2397,
      "lng": 120.1681,
      "note": "The lavish 19th-century mansion of a Qing-dynasty merchant banker, with carved halls, rockery gardens and ponds packed into a city block near Hefang Street.",
      "hours": "~8:00 AM–5:30 PM daily",
      "rating": 4.5
    },
    {
      "name": "Hangzhou Botanical Garden",
      "lat": 30.2552,
      "lng": 120.1231,
      "note": "A large hillside garden north-west of the lake with bamboo groves, plum and magnolia collections and shady trails, popular for spring blossoms.",
      "hours": "~6:30 AM–6:00 PM daily",
      "rating": 4.4
    },
    {
      "name": "Leifeng Pagoda",
      "lat": 30.2339,
      "lng": 120.1451,
      "note": "A rebuilt pagoda on the southern shore standing over the ruins of the 10th-century original; ride the escalator up for one of the best views across West Lake, especially at sunset.",
      "hours": "~8:00 AM–8:00 PM May–Oct, to ~5:30 PM Nov–mid-Mar; last ticket 30 min before",
      "rating": 4
    },
    {
      "name": "Jingci Temple",
      "lat": 30.2295,
      "lng": 120.149,
      "note": "A 10th-century Chan Buddhist temple at the foot of Nanping Hill, facing Leifeng Pagoda across Nanshan Road, whose great bell rings out the 'Evening Bell at Nanping Hill', one of the Ten Scenes of West Lake.",
      "hours": "~6:00 AM–5:30 PM daily",
      "rating": 4.2
    },
    {
      "name": "Gushan (Solitary Hill)",
      "lat": 30.2535,
      "lng": 120.139,
      "note": "The largest island in West Lake, linked by the Bai Causeway, with the Xiling Seal Engravers' Society gardens, Zhongshan Park and the free Zhejiang Museum Gushan branch.",
      "hours": "Island open all day; museum ~9:00 AM–5:00 PM, closed Mon",
      "rating": 4.5
    },
    {
      "name": "China National Silk Museum",
      "lat": 30.225,
      "lng": 120.1472,
      "note": "China's largest silk museum, south of the lake near Yuhuang Hill, tracing silk from cocoon to loom to five thousand years of costume; free entry.",
      "hours": "~9:00 AM–5:00 PM, closed Mon",
      "rating": 4.4
    },
    {
      "name": "Grand Canal & Gongchen Bridge",
      "lat": 30.3205,
      "lng": 120.1347,
      "note": "The southern end of the 1,800 km Beijing–Hangzhou Grand Canal, crossed by a triple-arched Ming stone bridge and lined with restored lanes and free canal museums; the water bus from Wulin Gate is a pleasant way to arrive.",
      "hours": "Waterfront open all day; museums ~9:00 AM–5:00 PM, closed Mon",
      "rating": 4.4
    },
    {
      "name": "Six Harmonies Pagoda",
      "lat": 30.1983,
      "lng": 120.1266,
      "note": "A 60 m Song-dynasty wooden-eaved pagoda on Yuelun Hill overlooking the Qiantang River, built to calm its famous tidal bore; climb the inner stairs for river views.",
      "hours": "~6:00 AM–5:30 PM daily",
      "rating": 4.1
    }
  ],
