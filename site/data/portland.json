  "sights": [
    {
      "name": "Portland Japanese Garden",
      "lat": 45.5188,
      "lng": -122.7066,
      "note": "Twelve acres of stroll, tea and sand-and-stone gardens on a Washington Park hillside, with a Kengo Kuma-designed cultural village and Mount Hood views.",
      "hours": "Wed–Mon 10 AM–5:30 PM (grounds to 6:30 PM; longer in summer); closed Tue",
      "rating": 4.5,
      "ticketUrl": "https://japanesegarden.org",
      "bookAhead": true
    },
    {
      "name": "International Rose Test Garden",
      "lat": 45.519,
      "lng": -122.7053,
      "note": "Terraced beds of more than 10,000 rose bushes testing new varieties, peaking from late May through September, with free entry and city views.",
      "hours": "Daily ~7:30 AM–9 PM; free",
      "rating": 4.6
    },
    {
      "name": "Lan Su Chinese Garden",
      "lat": 45.5254,
      "lng": -122.6735,
      "note": "A walled Ming-dynasty-style scholar's garden in Chinatown built by Suzhou artisans, with a lake, pavilions and a teahouse.",
      "hours": "Daily 10 AM–4:30 PM in fall/winter, 10 AM–6:30 PM spring/summer; last entry 30 min before close",
      "rating": 4.6,
      "ticketUrl": "https://lansugarden.org"
    },
    {
      "name": "The Grotto - National Sanctuary of Our Sorrowful Mother",
      "lat": 45.5532,
      "lng": -122.5733,
      "note": "A Catholic sanctuary with a rock-cave altar at the foot of a cliff and an elevator up to forested upper gardens with Columbia River views.",
      "hours": "Daily ~9 AM–5 PM (shorter in winter; extended for the Christmas Festival of Lights)",
      "rating": 4.6,
      "ticketUrl": "https://thegrotto.org"
    },
    {
      "name": "Pittock Mansion",
      "lat": 45.5252,
      "lng": -122.7163,
      "note": "A 1914 French Renaissance-style house museum high in the West Hills, with period rooms and a lawn overlooking the city and the Cascade volcanoes.",
      "hours": "Daily 10 AM–5 PM Apr–Oct, 9:30 AM–4:30 PM Nov–Jan, 10 AM–4 PM Feb–Mar; opens noon Tue",
      "rating": 4.5,
      "ticketUrl": "https://pittockmansion.org"
    },
    {
      "name": "Forest Park",
      "lat": 45.5355,
      "lng": -122.7118,
      "note": "One of the largest urban forests in the US, with 80+ miles of trails; the Lower Macleay trailhead leads up a creek canyon toward the Stone House and Pittock Mansion.",
      "hours": "Daily 5 AM–10 PM; free",
      "rating": 4.7
    },
    {
      "name": "Portland Art Museum",
      "lat": 45.5163,
      "lng": -122.6833,
      "note": "The Pacific Northwest's oldest art museum, reopened in late 2025 with the glass Rothko Pavilion linking its two buildings and Native American, Asian and modern collections.",
      "hours": "Tue–Sun 10 AM–5 PM; closed Mon",
      "rating": 4.4,
      "ticketUrl": "https://portlandartmuseum.org"
    },
    {
      "name": "Oregon Zoo",
      "lat": 45.5098,
      "lng": -122.716,
      "note": "A hillside zoo in Washington Park known for its elephant habitat, Pacific Northwest species and the seasonal ZooLights; it has its own MAX station.",
      "hours": "Daily from ~9:30 AM (9 AM spring/summer) to ~4–6 PM by season",
      "rating": 4.3,
      "ticketUrl": "https://www.oregonzoo.org",
      "bookAhead": true
    },
    {
      "name": "Hoyt Arboretum",
      "lat": 45.5155,
      "lng": -122.7155,
