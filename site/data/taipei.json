  "sights": [
    {
      "name": "Taipei 101 & Observatory",
      "lat": 25.034,
      "lng": 121.5645,
      "note": "The bamboo-shaped 508 m tower; ride one of the world's fastest lifts to the 89th-floor deck and see the giant wind-damper ball that steadies it in typhoons.",
      "hours": "Observatory 10:00 AM–9:00 PM daily (last entry 8:15 PM)",
      "ticketUrl": "https://www.taipei-101.com.tw/en/"
    },
    {
      "name": "National Palace Museum",
      "lat": 25.1024,
      "lng": 121.5485,
      "note": "Home to one of the world's largest collections of imperial Chinese art, including the famous Jadeite Cabbage; displays rotate, so not every star piece is always out.",
      "hours": "9:00 AM–5:00 PM, till 9:00 PM Fri & Sat, closed Mon",
      "ticketUrl": "https://www.npm.gov.tw/en/"
    },
    {
      "name": "Elephant Mountain",
      "lat": 25.0272,
      "lng": 121.5707,
      "note": "A short, steep stair trail (20–30 min up) to rocky lookouts with the classic postcard view of Taipei 101; best at sunset.",
      "hours": "Trail open 24 hours"
    },
    {
      "name": "Chiang Kai-shek Memorial Hall",
      "lat": 25.0346,
      "lng": 121.5218,
      "note": "A vast white-and-blue memorial set in Liberty Square between the National Theater and Concert Hall; the honor-guard change happens on the hour.",
      "hours": "Main hall 9:00 AM–6:00 PM daily; grounds ~5:00 AM–midnight"
    },
    {
      "name": "Maokong Gondola",
      "lat": 24.9961,
      "lng": 121.5768,
      "note": "A 4 km cable car from Taipei Zoo up to the tea-growing hills of Maokong, with teahouses and city views at the top; crystal-floor cabins available.",
      "hours": "Tue–Thu 9:00 AM–9:00 PM, Fri 9:00 AM–10:00 PM, Sat 8:30 AM–10:00 PM, Sun 8:30 AM–9:00 PM; closed most Mondays and in high wind"
    },
    {
      "name": "Longshan Temple",
      "lat": 25.0372,
      "lng": 121.4999,
      "note": "Taipei's best-loved folk temple, founded in 1738 and still busy with worshippers burning incense under ornate dragon-topped roofs.",
      "hours": "6:00 AM–10:00 PM daily"
    },
    {
      "name": "Taipei Zoo",
      "lat": 24.9984,
      "lng": 121.5808,
      "note": "A large, hilly zoo at the end of the Brown Line with giant pandas, a koala house and a big tropical rainforest section.",
      "hours": "9:00 AM–5:00 PM daily (last entry 4:00 PM)",
      "ticketUrl": "https://www.zoo.gov.taipei/"
    },
    {
      "name": "Raohe Street Night Market",
      "lat": 25.0507,
      "lng": 121.5772,
      "note": "A single 600 m lane of food stalls beside Ciyou Temple, famous for black-pepper pork buns baked in clay ovens.",
      "hours": "~5:00 PM–midnight daily"
    },
    {
      "name": "Ximending",
      "lat": 25.0422,
      "lng": 121.507,
      "note": "Taipei's pedestrianised youth and pop-culture district of street food, sneaker shops and buskers, anchored by the 1908 Red House.",
      "hours": "Streets always open; shops ~11:00 AM–10:00 PM"
    },
    {
      "name": "Beitou Hot Springs",
      "lat": 25.1367,
      "lng": 121.5069,
      "note": "A leafy hot-spring valley with public baths, the timber Hot Spring Museum, the steaming green Thermal Valley lake and an eco-friendly wooden library.",
      "hours": "Hot Spring Museum 10:00 AM–6:00 PM, Thermal Valley 9:00 AM–5:00 PM; both closed Mon"
    },
    {
      "name": "Yangmingshan National Park",
      "lat": 25.1555,
      "lng": 121.5479,
      "note": "Volcanic mountains on the city's northern edge with fumaroles, flower gardens, grassland ridges and hiking trails; pin is the main visitor center.",
      "hours": "Park open 24 hours; visitor center 9:00 AM–4:30 PM"
    },
    {
      "name": "Shilin Night Market",
      "lat": 25.0878,
      "lng": 121.5241,
      "note": "Taipei's biggest and busiest night market, with a basement food court plus lanes of games, fried chicken cutlets and stinky tofu.",
      "hours": "~4:00 PM–midnight daily"
    },
    {
      "name": "Dihua Street",
      "lat": 25.0557,
      "lng": 121.51,
      "note": "The old merchant street of Dadaocheng, lined with restored baroque shophouses selling dried goods, tea and fabric, plus the Xiahai City God Temple.",
      "hours": "Shops ~9:00 AM–7:00 PM"
    },
    {
      "name": "Huashan 1914 Creative Park",
      "lat": 25.0441,
      "lng": 121.5294,
      "note": "A former winery turned arts hub, with brick warehouses hosting exhibitions, design shops, cafés and weekend markets.",
      "hours": "Grounds open 24 hours; shops and galleries ~11:00 AM–9:00 PM"
    },
    {
      "name": "Dalongdong Baoan Temple",
      "lat": 25.0731,
      "lng": 121.5155,
      "note": "A UNESCO-award-winning restoration of an 18th-century temple, rich in carved stone pillars and painted beams, next to the Confucius Temple.",
      "hours": "6:30 AM–10:00 PM daily"
    },
    {
      "name": "National Revolutionary Martyrs' Shrine",
      "lat": 25.0782,
      "lng": 121.5329,
      "note": "A palace-style shrine to the Republic's war dead, best known for the precise changing of the guard that marches from the gate on the hour.",
      "hours": "9:00 AM–5:00 PM daily"
    },
    {
      "name": "Ningxia Night Market",
      "lat": 25.0566,
      "lng": 121.5154,
      "note": "A compact, locals' favourite night market focused on food: oyster omelettes, taro balls and braised pork rice.",
      "hours": "~5:00 PM–1:00 AM daily"
    },
    {
      "name": "Da'an Forest Park",
      "lat": 25.03,
      "lng": 121.5358,
      "note": "Taipei's 'Central Park': 26 hectares of lawns, ponds and shady paths, popular with joggers, families and egrets.",
      "hours": "Open 24 hours"
    }
  ],
