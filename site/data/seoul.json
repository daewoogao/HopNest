  "sights": [
    {
      "name": "Gyeongbokgung Palace",
      "lat": 37.5796,
      "lng": 126.977,
      "note": "The largest of Seoul's Joseon-dynasty palaces, with a changing-of-the-guard ceremony at the main gate. Entry is free if you wear hanbok.",
      "hours": "9:00 AM–6:00 PM (to 6:30 PM Jun–Aug, 5:00 PM Nov–Feb), closed Tue; last entry 1 hr before"
    },
    {
      "name": "Myeongdong Shopping Street",
      "lat": 37.5636,
      "lng": 126.985,
      "note": "Busy pedestrian lanes packed with Korean skincare shops, fashion stores and evening street-food stalls.",
      "hours": "Shops ~10:00 AM–10:00 PM; food stalls from ~4:00 PM"
    },
    {
      "name": "N Seoul Tower",
      "lat": 37.5512,
      "lng": 126.9882,
      "note": "Communications tower on top of Namsan with a 360° observation deck over the whole city. Reach it by cable car or a 30-minute uphill walk.",
      "hours": "Observatory ~10:00 AM–11:00 PM daily (last entry 30 min before)",
      "ticketUrl": "https://www.seoultower.co.kr"
    },
    {
      "name": "Insadong",
      "lat": 37.574,
      "lng": 126.9855,
      "note": "A traditional arts street of tea houses, galleries, calligraphy and craft shops, centred on the Ssamziegil spiral arcade.",
      "hours": "Shops ~10:00 AM–8:30 PM"
    },
    {
      "name": "National Museum of Korea",
      "lat": 37.5239,
      "lng": 126.9803,
      "note": "Korea's flagship museum: gold crowns from Silla, celadon ceramics and Buddhist art, with free entry to the permanent galleries.",
      "hours": "10:00 AM–6:00 PM, till 9:00 PM Wed & Sat; closed Jan 1, Seollal & Chuseok"
    },
    {
      "name": "The War Memorial of Korea",
      "lat": 37.5365,
      "lng": 126.9772,
      "note": "A large museum on Korea's military history, especially the Korean War, with tanks and aircraft displayed outdoors. Free.",
      "hours": "9:30 AM–6:00 PM, closed Mon"
    },
    {
      "name": "Cheonggyecheon Stream",
      "lat": 37.569,
      "lng": 126.9784,
      "note": "An 11 km restored stream running below street level through downtown, with walking paths, stepping stones and evening lights.",
      "hours": "Open 24 hours"
    },
    {
      "name": "Bukhansan National Park",
      "lat": 37.6588,
      "lng": 126.978,
      "note": "Granite peaks on the city's northern edge. The climb to Baegundae summit (836 m) is a steep half-day hike with views over Seoul.",
      "hours": "Trails open from about sunrise; climbing cut-off times apply in the afternoon"
    },
    {
      "name": "Changdeokgung Palace",
      "lat": 37.5794,
      "lng": 126.991,
      "note": "A UNESCO-listed palace laid out to follow the hillside. Its Secret Garden (Huwon) can only be seen on a guided tour with limited places.",
      "hours": "9:00 AM–6:00 PM (to 6:30 PM Jun–Aug, 5:30 PM Nov–Jan), closed Mon",
      "bookAhead": true
    },
    {
      "name": "Bukchon Hanok Village",
      "lat": 37.5826,
      "lng": 126.9836,
      "note": "Hillside lanes of tile-roofed traditional houses between two palaces. People still live here, so visitor hours apply and you should keep your voice down.",
      "hours": "Lanes in the core zone are open to tourists 10:00 AM–5:00 PM only"
    },
    {
      "name": "Namdaemun Market",
      "lat": 37.5592,
      "lng": 126.9776,
      "note": "Seoul's oldest and biggest traditional market: clothing, kitchenware, ginseng, and alleys of cheap knife-cut noodles and hotteok.",
      "hours": "Most shops ~9:00 AM–6:00 PM; many close on Sundays"
    },
    {
      "name": "Lotte World Tower",
      "lat": 37.5126,
      "lng": 127.1025,
      "note": "Korea's tallest building (555 m). The Seoul Sky deck on floors 117–123 includes a glass-floored skywalk.",
      "hours": "Seoul Sky ~10:30 AM–10:00 PM (later on Fri & Sat)",
      "ticketUrl": "https://seoulsky.lotteworld.com"
    },
    {
      "name": "Dongdaemun Design Plaza (DDP)",
      "lat": 37.5665,
      "lng": 127.0092,
      "note": "Zaha Hadid's curving aluminium landmark, used for design exhibitions. After dark its LED rose garden and the night markets nearby come alive.",
      "hours": "Building ~10:00 AM–8:00 PM; outdoor areas open 24 hours"
    },
    {
      "name": "Starfield Library",
      "lat": 37.5103,
      "lng": 127.0596,
      "note": "A two-storey atrium inside COEX Mall lined with 13 m bookshelves. Free to browse and very popular for photos.",
      "hours": "10:00 AM–10:00 PM daily"
    },
    {
      "name": "Bongeunsa Temple",
      "lat": 37.5148,
      "lng": 127.0577,
      "note": "A Buddhist temple founded over 1,200 years ago, with a 23 m Maitreya statue, set against the skyscrapers of Gangnam.",
      "hours": "Grounds open daily from early morning to ~10:00 PM"
    },
    {
      "name": "Gwangjang Market",
      "lat": 37.5701,
      "lng": 126.9996,
      "note": "A century-old covered market famous for its food alleys: bindaetteok mung-bean pancakes, yukhoe beef tartare and mayak gimbap.",
      "hours": "Food stalls ~9:00 AM–11:00 PM; fabric shops close earlier and many shut on Sundays"
    },
    {
      "name": "Yeouido Hangang Park",
      "lat": 37.5284,
      "lng": 126.933,
      "note": "Locals' favourite riverside park for picnics, bike rental and convenience-store ramyeon, with cherry blossoms in April and fireworks in autumn.",
      "hours": "Open 24 hours"
    },
    {
      "name": "Ikseon-dong Hanok Street",
      "lat": 37.5743,
      "lng": 126.9898,
      "note": "A tight cluster of 1920s hanok converted into cafés, bakeries and small restaurants, five minutes from Insadong.",
      "hours": "Shops ~11:00 AM–10:00 PM"
    }
  ],
